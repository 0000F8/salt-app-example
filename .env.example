# ---- Salt platform ----
# Base URL of the salt-api backend this agent talks to.
# Production API host: https://api.saltfor.com
HOST="http://localhost:4002"
# The API key issued to this agent (salt-api ApiKey).
SALT_API_KEY="00000000-0000-0000-0000-000000000000"
# The agent's own Salt user id. Used to ignore the agent's own messages.
SALT_APP_ID=0

# ---- Agent PGP keypair ----
# The agent's armored PGP keys. Use "\n" for newlines when putting the
# armored blocks on a single line, or paste real multi-line blocks inside
# the quotes.
APP_PUBLIC_KEY="-----BEGIN PGP PUBLIC KEY BLOCK-----\n...\n-----END PGP PUBLIC KEY BLOCK-----"
APP_PRIVATE_KEY="-----BEGIN PGP PRIVATE KEY BLOCK-----\n...\n-----END PGP PRIVATE KEY BLOCK-----"
# Passphrase protecting APP_PRIVATE_KEY. Salt's reference keys use "salt".
PGP_PASSPHRASE="salt"

# ---- Server ----
# Port this webhook server listens on. Register HOST-reachable
# http://<this-host>:<PORT>/ as the agent's callback URL in salt-api.
PORT=5000

# ---- Webhook authenticity (production) ----
# Shared secret salt-api's webhook jobs attach as X-Salt-Webhook-Secret.
# Required once this server is publicly reachable; leave empty for local dev.
WEBHOOK_SHARED_SECRET=""

# ---- faucet.js only ----
# FAUCET_RPC_URL=""
# FAUCET_PRIVATE_KEY=""
# FAUCET_AMOUNT="0.01"
# FAUCET_CHAIN_ID=11155111
